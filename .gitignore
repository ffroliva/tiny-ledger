# Build output
target/

# Source briefs held for reference only. They are the assessor's material, not
# ours to redistribute, private repo or not. Kept on disk, never committed.
docs/source/

# Tooling caches
.pytest_cache/
.serena/
__pycache__/

# Keys never land by accident. TestJwt now generates its signing key per-JVM instead of loading a
# committed PEM (see that class), so there is nothing left to un-ignore — recreating either filename
# would silently re-enable tracking, which is exactly what removing them was meant to end.
*.pem
